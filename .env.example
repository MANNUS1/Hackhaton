# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE - SOFTWARE WEEK 2026
# Duplicate this file to .env and fill in the values. NEVER commit the .env file.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Backend API Configuration
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql://user:password@localhost:5432/hackathon_db

# Artificial Intelligence & LLM Provider
# e.g., Google Gemini / OpenAI
AI_API_KEY=your_ai_api_key_here
AI_MODEL_NAME=gemini-2.0-flash

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
